#!/usr/bin/env python3
# Interact with remote oracle to find shifts where MSB equals 0x67
import socket
import re
import sys

HOST = 'challs.umdctf.io'
PORT = 32767

# n and e from server.py
n = 
e = 65537

s = socket.create_connection((HOST, PORT))
# read until prompt
data = s.recv(4096).decode()
print(data)
# extract ct
m = re.search(r"Your flag: (\d+)", data)
if not m:
    print('No ct found')
    sys.exit(1)
ct = int(m.group(1))
print('ct=',ct)

# helper to send a single ciphertext and read response

def query(c):
    # send c then newline
    msg = str(c) + "\n"
    s.send(msg.encode())
    out = s.recv(4096).decode()
    return out

# Test original ct
print('Querying original ct...')
print(query(ct))

# Test multipliers pow(256,k)
for k in range(0,80):
    t = pow(256,k,n)
    c2 = (ct * pow(t,e,n)) % n
    out = query(c2)
    if 'BRAINROT' in out or 'ERROR' in out:
        print('k=',k,'-> BRAINROT')
    else:
        print('k=',k,'-> OK')

s.close()
