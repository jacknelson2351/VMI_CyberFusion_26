"""Attack script to find a submission array within L-inf EPS of reference that flips classifier after purification.
Saves candidate to candidate.npy and prints base64 for manual submission.
"""
import base64
import io
import numpy as np
import torch
import torch.nn.functional as F
from predictor import Predictor
from flow import RealNVP
from pathlib import Path

HERE = Path(__file__).parent
HANDOUT = HERE / "dist"
EPS = 0.05
CONF_FLIP = 0.80
PURIFY_STEPS = 3
PURIFY_ALPHA = 0.55

# load
x_ref = np.load(HANDOUT / "reference_window.npy")
predictor = Predictor()
predictor.load_state_dict(torch.load(HANDOUT / "predictor.pt"))
predictor.eval()
d = torch.load(HANDOUT / "flow.pt")
flow = RealNVP(channels=d["channels"], window=d["window"], n_layers=d["n_layers"], hidden=d["hidden"])
flow.load_state_dict(d["state_dict"])
flow.eval()
lp_thresh = float(d["threshold"])

device = torch.device('cpu')

x0 = torch.from_numpy(x_ref).to(device)
# start at x_ref
x = x0.clone().detach()
x = x.requires_grad_(True)
opt = torch.optim.Adam([x], lr=1e-2)

def purify(t, flow, n_steps=PURIFY_STEPS, alpha=PURIFY_ALPHA):
    x = t
    for _ in range(n_steps):
        z, _ = flow.forward(x)
        x = flow.inverse(alpha * z)
    return x

best = None
best_score = -1
for restart in range(3):
    # reinit x near x_ref with tiny noise
    with torch.no_grad():
        x.data = x0 + 0.001 * torch.randn_like(x0)
    x.requires_grad_(True)
    opt = torch.optim.Adam([x], lr=5e-3)
    for it in range(2000):
        opt.zero_grad()
        t = x.unsqueeze(0)
        # compute log_prob
        lp = flow.log_prob(t)
        purified = purify(t, flow)
        logits = predictor(purified)
        probs = F.softmax(logits, dim=1)
        p1 = probs[0,1]
        # objective: maximize p1, also encourage lp >= thresh
        # use loss = -p1 + hinge on lp
        hinge = torch.clamp(lp_thresh - lp, min=0.0)
        loss = -p1 + 0.01 * hinge
        loss.backward()
        # gradient step
        opt.step()
        # project to L-inf ball
        with torch.no_grad():
            x.data = torch.max(torch.min(x, x0 + EPS), x0 - EPS)
            # also keep as float32
            x.data = x.data.to(torch.float32)
        if it % 100 == 0:
            with torch.no_grad():
                val_lp = float(lp.item())
                val_p1 = float(p1.item())
            print(f"restart {restart} it {it} loss {loss.item():.4f} p1 {val_p1:.4f} lp {val_lp:.2f}")
        # check success
        with torch.no_grad():
            if float(p1) >= CONF_FLIP and float(lp) >= lp_thresh:
                print(f"Found candidate at restart {restart} it {it} p1={float(p1):.4f} lp={float(lp):.2f}")
                cand = x.detach().cpu().numpy().astype(np.float32)
                np.save('candidate.npy', cand)
                # print base64
                bio = io.BytesIO()
                np.save(bio, cand)
                b64 = base64.b64encode(bio.getvalue()).decode()
                print(b64)
                raise SystemExit(0)

print("No candidate found")
# save best attempt
np.save('candidate.npy', x.detach().cpu().numpy().astype(np.float32))
