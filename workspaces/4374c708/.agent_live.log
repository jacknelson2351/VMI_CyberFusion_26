import struct, math

# inspect first 256 floats that look printable as bytes
with open('grad.dat','rb') as f:
    data = f.read()

floats = struct.unpack('<%df' % (len(data)//4), data)

cand = []
for i, x in enumerate(floats[:4096]):
    b = int(x) & 0xff
    if 32 <= b <= 126:
        cand.append((i, x, chr(b)))

print('candidates', len(cand))
print(cand[:50])

# also try interpreting as raw bytes looking for flag pattern
raw = data
for i in range(len(raw)-6):
    if raw[i:i+1] == b'{':
        seg = raw[i:i+64]
        if all(32 <= c < 127 for c in seg):
            print(i, seg)
