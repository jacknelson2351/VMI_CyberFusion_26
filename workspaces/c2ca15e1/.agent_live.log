[2026-04-25T01:15:11Z] CMD sed -n '1,240p' exploit.py
from policy import load_default_policy
from attack import AttackModel, load_from_base64
from observations import generate_observation, OBS_DIM
from physics import initial_car
from game import GameState, CTF_GOAL, LEGIT_GOAL
import numpy as np
import base64
import io

# compute initial obs for LEGIT_GOAL and CTF_GOAL
car = initial_car()
obs_legit = generate_observation(car, LEGIT_GOAL)
obs_ctf = generate_observation(car, CTF_GOAL)
delta = obs_ctf - obs_legit
print('obs_legit =', obs_legit)
print('obs_ctf  =', obs_ctf)
print('delta    =', delta)
print('delta L2 =', np.linalg.norm(delta))

# build simple attack: constant output equal to delta, if small enough
MAX_DELTA_L2 = 0.5
if np.linalg.norm(delta) > MAX_DELTA_L2:
    print('delta too large, scaling down to max L2')
    delta = delta * (MAX_DELTA_L2 / np.linalg.norm(delta))
    print('scaled delta L2 =', np.linalg.norm(delta))

# create arrays for AttackModel: W0 (16,8), b0 (16,), W1 (8,16), b1 (8,)
W0 = np.zeros((16,8), dtype=np.float32)
b0 = np.zeros((16,), dtype=np.float32)
W1 = np.zeros((8,16), dtype=np.float32)
# set b1 = arctanh(delta) but ensure |delta_i|<1
if np.any(np.abs(delta) >= 1.0):
    raise SystemExit('delta component >=1, cannot invert tanh')
b1 = np.arctanh(delta).astype(np.float32)

# save to npz in memory
buf = io.BytesIO()
np.savez(buf, W0=W0, b0=b0, W1=W1, b1=b1)
raw = buf.getvalue()
b64 = base64.b64encode(raw).decode()
print('npz size', len(raw))

# try loading via AttackModel loader
try:
    attack_model = load_from_base64(b64)
    print('AttackModel loaded')
except Exception as e:
    print('Failed to load attack:', e)
    raise

# simulate game with this attack
policy = load_default_policy()
from game import GameState
G = GameState(policy)
G.install_attack(attack_model)

# run simulation step until timeout or goal reached
dt = 0.1
for i in range(1000):
    G.step(dt)
    if G.goal_reached:
        print('Goal reached, flag =', G.flag)
        break
    if G.timed_out:
        print('Timed out at t=', G.time)
        break
else:
    print('No terminal state after steps, time=', G.time)

# print final position
print('final pos', G.car.x, G.car.z, 'time', G.time)
