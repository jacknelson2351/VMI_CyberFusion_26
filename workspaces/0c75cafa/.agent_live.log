import json,sys,socket,time
s=json.loads(sys.argv[1])
url=(s.get('url') or '').strip()
def log(*a): print(*a)
if url.startswith('ws://') or url.startswith('wss://'):
    try:
        import websocket
    except Exception:
        import subprocess; subprocess.run(['pip','install','-q','websocket-client'])
        import websocket
    ws=websocket.create_connection(url, timeout=s['recv_timeout'])
    log('WS CONNECTED', url)
    try:
        ws.settimeout(s['recv_timeout'])
        try:
            log('RECV<', ws.recv())
        except Exception: pass
        for msg in s['send']:
            ws.send(msg); log('SEND>', msg)
            try: log('RECV<', ws.recv())
            except Exception as e: log('(no reply:', e, ')')
    finally:
        ws.close()
else:
    host=s.get('host') or ''; port=int(s.get('port') or 0)
    if url.startswith('tcp://'):
        rest=url[6:]; host=rest.split(':')[0]; port=int(rest.split(':')[1])
    if not host or not port:
        print('[error] no host/port'); sys.exit(0)
    sock=socket.create_connection((host,port), timeout=s['recv_timeout'])
    sock.settimeout(s['recv_timeout'])
    log('TCP CONNECTED', host, port)
    def drain():
        buf=b''
        try:
            while True:
                d=sock.recv(4096)
                if not d: break
                buf+=d
                if s['read_until'] and s['read_until'].encode() in buf: break
                if len(buf)>65536: break
        except Exception: pass
        return buf.decode('utf-8','replace')
    log('RECV<', drain())
    for line in s['send']:
        data=(line if line.endswith(chr(10)) else line+chr(10)).encode()
        sock.sendall(data); log('SEND>', line)
        log('RECV<', drain())
    sock.close()
