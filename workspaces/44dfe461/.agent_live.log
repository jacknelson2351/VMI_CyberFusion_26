import json, sys
from pathlib import Path
from http.cookiejar import MozillaCookieJar
import requests
spec = json.loads(sys.argv[1])
session_name = spec.get('session_name') or 'default'
session_dir = Path('/ctf/.sessions')
session_dir.mkdir(parents=True, exist_ok=True)
cookie_path = session_dir / f"{session_name}.cookies.txt"
jar = MozillaCookieJar(str(cookie_path))
if cookie_path.exists():
    try:
        jar.load(ignore_discard=True, ignore_expires=True)
    except Exception:
        pass
sess = requests.Session()
sess.cookies = jar
files_spec = spec.get('files') or {}
req_files = None
opened_handles = []
def ctf_path(value):
    raw = str(value or '')
    if raw.startswith('/ctf/'):
        return Path(raw)
    return Path('/ctf') / raw.lstrip('/')
if files_spec:
    req_files = {}
    for field, val in files_spec.items():
        if isinstance(val, dict):
            fpath_full = ctf_path(val.get('path'))
            fname = val.get('filename') or fpath_full.name
            mime = val.get('mime_type') or val.get('mime') or 'application/octet-stream'
            fh = open(fpath_full, 'rb')
            opened_handles.append(fh)
            req_files[field] = (fname, fh, mime)
        elif isinstance(val, list) and len(val) >= 2:
            fname, fpath = val[0], val[1]
            mime = val[2] if len(val) > 2 else 'application/octet-stream'
            fh = open(ctf_path(fpath), 'rb')
            opened_handles.append(fh)
            req_files[field] = (fname, fh, mime)
        else:
            fpath_full = ctf_path(val)
            fh = open(fpath_full, 'rb')
            opened_handles.append(fh)
            req_files[field] = (fpath_full.name, fh, 'application/octet-stream')
try:
    if req_files:
        resp = sess.request(
            spec.get('method', 'GET').upper(),
            spec['url'],
            headers=spec.get('headers') or None,
            data=spec.get('form') or None,
            files=req_files,
            allow_redirects=bool(spec.get('follow_redirects', True)),
            timeout=int(spec.get('timeout') or 20),
        )
    else:
        resp = sess.request(
            spec.get('method', 'GET').upper(),
            spec['url'],
            headers=spec.get('headers') or None,
            data=spec.get('body') if spec.get('body') is not None else (spec.get('form') or None),
            json=spec.get('json_body'),
            allow_redirects=bool(spec.get('follow_redirects', True)),
            timeout=int(spec.get('timeout') or 20),
        )
finally:
    for fh in opened_handles:
        try: fh.close()
        except Exception: pass
sess.cookies.save(ignore_discard=True, ignore_expires=True)
save_to = (spec.get('save_to') or '').lstrip('/')
saved_path = ''
if save_to:
    dest = Path('/ctf') / save_to
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(resp.content)
    saved_path = str(dest)
print(f'STATUS {resp.status_code}')
print(f'FINAL_URL {resp.url}')
print(f'COOKIE_JAR {cookie_path}')
if saved_path:
    print(f'SAVED_TO {saved_path}')
for key, value in list(resp.headers.items())[:20]:
    print(f'HEADER {key}: {value}')
print('')
print('BODY_PREVIEW')
text = resp.text[:4000]
print(text)
