from pwn import *

def run(payload):
  p=process(['/ctf/roulette'])
  p.send(payload)
  return p.recvall(timeout=1).decode('utf-8','ignore')

# try different padding bytes and exact lengths around 0x6a
for L in [0x6a,0x6b,0x69]:
  pad=L-2  # '1' + '\n'
  payload=b'1'+b'0'*pad+b'\n'
  out=run(payload)
  print('L',L,'->',('accepted' in out),out.strip().split('\n')[-1])
