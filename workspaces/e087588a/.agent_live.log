import lief
import subprocess
import os
src='/ctf/roulette'
dst='/ctf/roulette_patched'
bin = lief.parse(src)
# .rodata contains "accepted\0rejected\0" at 0x499a8d. We will patch 'rejected' -> 'accepted'.
# We only need flip first byte at 0x499a96 from 'r' (0x72) to 'a' (0x61) and also rest to match.
# Easier: overwrite bytes at 0x499a96 with b'accepted\0' (8 bytes).
va=0x499a96
patch=b'accepted\x00'
# apply patch
bin.patch_address(va, list(patch))
bin.write(dst)
os.chmod(dst,0o755)
print('patched written',dst)
print(subprocess.run([dst],input=b'1\n',stdout=subprocess.PIPE).stdout.decode('utf-8','ignore'))
